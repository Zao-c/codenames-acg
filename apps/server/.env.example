PORT=3001
CLIENT_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
USE_MEMORY_STORE=0

# Phase 2 capabilities are disabled until the operator enables them.
ENABLE_MATCH_ANALYSIS=0
ENABLE_PREDICTIONS=0
ENABLE_ANIME_COMMUNITY=0
# Relative to the server process working directory; use an absolute path in production.
ANIME_POOL_STORE_FILE=./data/anime-pools.json
# Set a separately generated random credential of at least 32 characters. Never commit it.
ANIME_POOL_ADMIN_KEY=
